# Vitastir Doctor Credentials - Copy to .env and fill in your details
DOCTOR_USERNAME=your_doctor_username
DOCTOR_PASSWORD=your_doctor_password

# Service Configuration (check_patients.py defaults to Practice Fusion Tasks page)
# LOGIN_URL=https://static.practicefusion.com/apps/ehr/index.html#/login
# DASHBOARD_URL=https://static.practicefusion.com/apps/ehr/index.html#/PF/tasks/lists
LOGIN_URL=https://your-service.com/login
DASHBOARD_URL=https://your-service.com/dashboard
APPROVAL_PAGE_URL=https://your-service.com/patients/pending

# Selenium Settings
HEADLESS=false
WAIT_TIMEOUT=30
IMPLICIT_WAIT=10

# check_patients.py login logging (INFO, DEBUG, …)
# CHECK_PATIENTS_LOG_LEVEL=INFO

# CSS/XPath Selectors - Update these to match the actual website
LOGIN_USERNAME_SELECTOR=input[name="username"], #username
LOGIN_PASSWORD_SELECTOR=#inputPswd, input[type="password"], #password
LOGIN_BUTTON_SELECTOR=button[type="submit"]

PATIENT_ROW_SELECTOR=.patient-row, tr[data-patient-id]
APPROVE_BUTTON_SELECTOR=button.approve, button:has-text("Approve")
APPROVE_ALL_BUTTON_SELECTOR=#approve-all
